{
  "name": "openvectoreditor",
  "displayName": "openvectoreditor",
  "description": "DNA editor in vscode",
  "version": "1.1.3",
  "publisher": "sanekun",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanekun/ove-vscode"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "DNA", "vector", "genbank", "biology", "plasmid", "research"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dna",
        "extensions": [
          ".dna",
          ".fasta",
          ".gb"
        ],
        "aliases": [
          "DNA",
          "dna"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "openvectoreditor.editor",
        "displayName": "OVE",
        "selector": [
          {
            "filenamePattern": "*.dna",
            "binary": true
          },
          {
            "filenamePattern": "*.fasta"
          },
          {
            "filenamePattern": "*.gb"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "openvectoreditor.show",
        "title": "openvectoreditor:show"
      }
    ],
    "configuration": {
      "title": "openvectoreditor",
      "properties": {
        "openvectoreditor.viewType": {
          "type": "string",
          "default": "sequence",
          "description": "Select the default view type for the editor.",
          "enum": [
            "sequence",
            "circular",
            "split"
          ],
          "enumDescriptions": [
            "Show sequence only.",
            "Show circular map only.",
            "Show sequence and circular map."
          ]
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "yarn run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.98.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.21.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "react": "^19.0.0"
  }
}
